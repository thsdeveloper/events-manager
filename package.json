{
	"name": "events-manager",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "pnpm supabase:start && pnpm dev:apps",
		"dev:apps": "concurrently -k -n api,web -c blue,green \"pnpm --filter @events-manager/api dev\" \"pnpm --filter @events-manager/web dev\"",
		"dev:api": "pnpm --filter @events-manager/api dev",
		"dev:web": "pnpm --filter @events-manager/web dev",
		"build": "pnpm -r --if-present build",
		"lint": "pnpm -r --if-present lint",
		"test": "pnpm -r --if-present test",
		"test:coverage": "pnpm -r --if-present test:coverage",
		"test:api": "pnpm --filter @events-manager/api test",
		"test:web": "pnpm --filter @events-manager/web test",
		"test:contracts": "pnpm --filter @events-manager/contracts test",
		"format": "prettier --write \"{apps,packages}/**/*.{js,jsx,ts,tsx,json,md}\"",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript --local > packages/contracts/src/database.types.ts",
		"admin:promote": "node scripts/promote-super-admin.mjs"
	},
	"devDependencies": {
		"concurrently": "^9.2.0",
		"prettier": "^3.5.3",
		"supabase": "^2.34.3",
		"typescript": "^5.8.3"
	}
}
