{
	"name": "@events-manager/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "pnpm --filter @events-manager/contracts build",
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"lint": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:tdd": "vitest --reporter=dot"
	},
	"dependencies": {
		"@events-manager/contracts": "workspace:*",
		"@fastify/cookie": "^11.0.0",
		"@fastify/cors": "^11.0.0",
		"@fastify/multipart": "^9.0.0",
		"@supabase/supabase-js": "^2.0.0",
		"@xmldom/xmldom": "^0.9.12",
		"dotenv": "^16.4.7",
		"fastify": "^5.12.8",
		"fastify-raw-body": "^5.0.0",
		"nodemailer": "^10.6.0",
		"openai": "^6.4.0",
		"pdfkit": "0.20.2",
		"qrcode": "1.5.4",
		"sharp": "^0.35.5",
		"ws": "^8.18.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.14.0",
		"@types/nodemailer": "^6.4.17",
		"@types/pdfkit": "0.17.7",
		"@types/qrcode": "1.5.5",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "4.1.12",
		"jsqr": "1.4.0",
		"pdfjs-dist": "^6.5.438",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"vite": "^7.3.8",
		"vitest": "4.1.12"
	}
}
