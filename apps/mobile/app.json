{
	"expo": {
		"name": "Flouvi",
		"slug": "flouvi-cliente",
		"owner": "thsdeveloper",
		"version": "1.0.0",
		"scheme": "flouvi",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "light",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "br.com.flouvi.cliente"
		},
		"android": {
			"package": "br.com.flouvi.cliente",
			"adaptiveIcon": {
				"foregroundImage": "./assets/symbol.png",
				"backgroundColor": "#F3EEFF"
			}
		},
		"web": {
			"favicon": "./assets/icon.png",
			"bundler": "metro",
			"output": "single"
		},
		"plugins": [
			"expo-router",
			"expo-image",
			"expo-font",
			"expo-secure-store",
			[
				"expo-splash-screen",
				{
					"image": "./assets/symbol.png",
					"imageWidth": 160,
					"backgroundColor": "#F3EEFF"
				}
			],
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"asyncRoutes": {
					"web": true
				}
			},
			"eas": {
				"projectId": "8e8f295f-1517-4574-8f39-3c9fd83077e8"
			}
		},
		"sdkVersion": "58.0.0",
		"updates": {
			"url": "https://u.expo.dev/8e8f295f-1517-4574-8f39-3c9fd83077e8"
		}
	}
}
